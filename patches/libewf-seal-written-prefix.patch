diff --git a/libewf/libewf_metadata.c b/libewf/libewf_metadata.c
--- a/libewf/libewf_metadata.c
+++ b/libewf/libewf_metadata.c
@@ -754,9 +754,50 @@ int libewf_handle_set_media_size(
 
 		return( -1 );
 	}
-	if( ( internal_handle->read_io_handle != NULL )
-	 || ( internal_handle->write_io_handle == NULL )
-	 || ( internal_handle->write_io_handle->values_initialized != 0 ) )
+	if( internal_handle->write_io_handle == NULL )
+	{
+		libcerror_error_set(
+		 error,
+		 LIBCERROR_ERROR_DOMAIN_RUNTIME,
+		 LIBCERROR_RUNTIME_ERROR_SET_FAILED,
+		 "%s: media size cannot be changed.",
+		 function );
+
+		return( -1 );
+	}
+	if( internal_handle->write_io_handle->values_initialized != 0 )
+	{
+		/* DiskBackuper extension: allow an active write to be sealed at the
+		 * exact, sector-aligned prefix that has already reached EWF chunks.
+		 * Arbitrary media-size changes remain prohibited.
+		 */
+		if( ( internal_handle->write_io_handle->write_finalized != 0 )
+		 || ( internal_handle->media_values->media_size == 0 )
+		 || ( media_size == 0 )
+		 || ( media_size >= internal_handle->media_values->media_size )
+		 || ( media_size != (size64_t) internal_handle->write_io_handle->input_write_count )
+		 || ( internal_handle->media_values->bytes_per_sector == 0 )
+		 || ( ( media_size % internal_handle->media_values->bytes_per_sector ) != 0 ) )
+		{
+			libcerror_error_set(
+			 error,
+			 LIBCERROR_ERROR_DOMAIN_RUNTIME,
+			 LIBCERROR_RUNTIME_ERROR_SET_FAILED,
+			 "%s: initialized media size can only be reduced to the written sector-aligned prefix.",
+			 function );
+
+			return( -1 );
+		}
+		internal_handle->media_values->media_size        = media_size;
+		internal_handle->media_values->number_of_sectors =
+			(uint64_t) ( media_size / internal_handle->media_values->bytes_per_sector );
+		internal_handle->media_values->number_of_chunks  =
+			internal_handle->write_io_handle->number_of_chunks_written;
+		internal_handle->write_io_handle->finalize_with_media_size_correction = 1;
+
+		return( 1 );
+	}
+	if( internal_handle->read_io_handle != NULL )
 	{
 		libcerror_error_set(
 		 error,
